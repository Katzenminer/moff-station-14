<cartridges:ChitterLookupView xmlns="https://spacestation14.io"
             xmlns:cartridges="clr-namespace:Content.Client._Moffstation.CartridgeLoader.Cartridges"
             Orientation="Vertical"
             VerticalExpand="True"
             MinWidth="250">
    <BoxContainer Orientation="Horizontal">
        <Label Text="{Loc chitter-lookup-title}" HorizontalExpand="True" />
        <Button Name="CloseLookupButton" Text="{Loc chitter-close}" />
    </BoxContainer>

    <LineEdit Name="SearchInput" PlaceHolder="{Loc chitter-search-placeholder}" />
    <ScrollContainer VerticalExpand="True" MinSize="200 200">
        <BoxContainer Name="SearchResults" Orientation="Vertical" />
    </ScrollContainer>

    <Button Name="CreateChatButton" Text="{Loc chitter-create-chat}" Disabled="True" />

</cartridges:ChitterLookupView>
