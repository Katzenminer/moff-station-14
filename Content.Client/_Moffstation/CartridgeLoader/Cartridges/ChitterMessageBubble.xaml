<cartridges:ChitterMessageBubble xmlns="https://spacestation14.io"
             xmlns:cartridges="clr-namespace:Content.Client._Moffstation.CartridgeLoader.Cartridges"
             Orientation="Vertical"
             Margin="4">
    <Label Name="SenderLabel" Text="" FontColorOverride="#888888" />
    <PanelContainer Name="BubbleBackground" MinWidth="100">
        <BoxContainer Orientation="Vertical">
            <Label Name="MessageLabel" Text="" />
            <BoxContainer Orientation="Horizontal">
                <Label Name="TimestampLabel" Text="" FontColorOverride="#666666" />
                <Label Name="FailedLabel" Text="{Loc chitter-delivery-failed}" FontColorOverride="#FF4444" Visible="False" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</cartridges:ChitterMessageBubble>
